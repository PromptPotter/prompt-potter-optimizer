{
  "name": "PromptPotter Optimizer",
  "version": "v1.0",
  "nodes": {
    "l1_generate": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.7,
        "output_format": "json",
        "prompt_family": "l1_generate",
        "context_sources": ["l1_critique", "task_context", "escalation_journal"],
        "response_parser": "candidate_list"
      }
    },
    "l1_score": {
      "type": "evaluation",
      "config": {
        "improvement_threshold": 0.01,
        "stale_data_load_protocol": ["rerun", "samplescan", "sampleswitch"],
        "rerun_trigger_count": 3,
        "samplescan_candidates": 3,
        "samplescan_threshold": 0.5,
        "sampleswitch_min_degradation_rate": 0.5
      },
      "optimizer": {
        "param_keys": [
          "rerun_trigger_count",
          "samplescan_candidates",
          "samplescan_threshold",
          "sampleswitch_min_degradation_rate"
        ]
      }
    },
    "l1_critique": {
      "type": "agent",
      "config": {
        "temperature": 0.3,
        "agent_class": "L1CritiqueAgent",
        "positive_threshold": 0.7
      }
    },
    "l2_context": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.3,
        "output_format": "json",
        "prompt_family": "l2_context",
        "context_sources": ["l1_critique", "task_context", "l2_directive"],
        "response_parser": "transition_result"
      }
    },
    "l3_plan": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.5,
        "output_format": "json",
        "prompt_family": "l3_plan",
        "context_sources": ["l1_critique", "task_context", "plan", "escalation_journal"],
        "response_parser": "transition_result"
      }
    },
    "restructure": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.3,
        "output_format": "json"
      }
    }
  },
  "pipelines": {
    "l1_round": ["l1_generate", "l1_score"],
    "l1_round_with_l1_critique": ["l1_generate", "l1_score", "l1_critique"],
    "l2_escalation": ["l2_context", "l1_generate", "l1_score", "l1_critique"],
    "l3_escalation": ["l3_plan", "l2_context", "l1_generate", "l1_score", "l1_critique"]
  }
}
