{
  "l1_generate/1": {
    "fields": [
      "variants",
      "recombinations"
    ],
    "json_schema": {
      "name": "l1_generate",
      "strict": true,
      "schema": {
        "$defs": {
          "L1Recombination": {
            "additionalProperties": false,
            "properties": {
              "main": {
                "description": "A RECOMBINATION POOL id marked main: the line the child continues, giving every locus `from_donor` omits.",
                "title": "Main",
                "type": "string"
              },
              "donor": {
                "description": "Another pool id, of any round: it gives the `from_donor` loci.",
                "title": "Donor",
                "type": "string"
              },
              "from_donor": {
                "description": "The loci, as `node.field`, the donor gives: fewer than half of those the two differ on, one where they differ on two; more drops the child mechanically.",
                "items": {
                  "type": "string"
                },
                "title": "From Donor",
                "type": "array"
              },
              "changes_description": {
                "title": "Changes Description",
                "type": "string"
              }
            },
            "required": [
              "main",
              "donor",
              "from_donor",
              "changes_description"
            ],
            "title": "L1Recombination",
            "type": "object"
          },
          "L1Variant": {
            "additionalProperties": false,
            "properties": {
              "evidence_grounding": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/VariantEvidenceGrounding"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "targets_rows": {
                "anyOf": [
                  {
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The rows this edit must hold for, by their `[#id]` marks — at least two, and all inside ONE critique cluster where the CRITIQUE panel lists clusters.",
                "title": "Targets Rows"
              },
              "pipeline_overlay": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {},
                    "type": "object",
                    "required": []
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Nested {node: {param: value}} — scalar backend tunables and `output_schema_descriptions.<path>` prose, each a param under ITS NODE, NEVER a top-level key beside the nodes. Scalar params (temperature, tokens, effort) are a last resort: at most one, and only where a panel or a runtime failure points there.",
                "title": "Pipeline Overlay"
              },
              "prompt_fields_updates": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {},
                    "type": "object",
                    "required": []
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Per prompt node, its prompt fields: {node: {field: new full text}}.",
                "title": "Prompt Fields Updates"
              },
              "shots": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {},
                    "type": "object",
                    "required": []
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Per prompt node, the shots it runs with: demo-pool ids from the DEMO POOL panel, in order. Replaces that node's list; null keeps it.",
                "title": "Shots"
              },
              "changes_description": {
                "title": "Changes Description",
                "type": "string"
              }
            },
            "required": [
              "evidence_grounding",
              "targets_rows",
              "pipeline_overlay",
              "prompt_fields_updates",
              "shots",
              "changes_description"
            ],
            "title": "L1Variant",
            "type": "object"
          },
          "VariantEvidenceGrounding": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "description": "A citable panel named in the prompt, or stall_exploration.",
                "title": "Field",
                "type": "string"
              },
              "citation": {
                "title": "Citation",
                "type": "string"
              }
            },
            "required": [
              "field",
              "citation"
            ],
            "title": "VariantEvidenceGrounding",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "variants": {
            "items": {
              "$ref": "#/$defs/L1Variant"
            },
            "title": "Variants",
            "type": "array"
          },
          "recombinations": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/L1Recombination"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recombinations"
          }
        },
        "required": [
          "variants",
          "recombinations"
        ],
        "title": "L1GenerateOutput",
        "type": "object"
      }
    }
  },
  "l1_critique/1": {
    "fields": [
      "failure_highlights",
      "priority_fix",
      "suggested_axes"
    ],
    "json_schema": {
      "name": "l1_critique",
      "strict": true,
      "schema": {
        "$defs": {
          "FailureCluster": {
            "additionalProperties": false,
            "properties": {
              "sample_ids": {
                "description": "The rows this cluster spans, by the `[#id]` marks in the panels — at least two, and as many as DETECTABLE MOVE names; an unmarked id is struck, and a cluster left narrower is dropped. Two rows that fail for different reasons are two clusters, never one.",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "title": "Sample Ids",
                "type": "array"
              },
              "mechanism": {
                "description": "The ONE root cause, as a short label naming the cognitive move that fails.",
                "title": "Mechanism",
                "type": "string"
              },
              "claim": {
                "description": "WHY these rows land wrong, in your own words: the step that breaks and what was said against the truth. General over the cluster, never one row's procedure.",
                "title": "Claim",
                "type": "string"
              }
            },
            "required": [
              "sample_ids",
              "mechanism",
              "claim"
            ],
            "title": "FailureCluster",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "failure_highlights": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/FailureCluster"
                },
                "maxItems": 3,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "One per DISTINCT failure cluster, ≤3, largest first.",
            "title": "Failure Highlights"
          },
          "priority_fix": {
            "description": "The single strongest steer, as `<axis>: <concrete change>`. The axis leads, before the colon, named VERBATIM from the axis list this node's prompt states. One you invent is dropped downstream and takes the steer's axis menu with it, so the next round reads a fix naming no lever it can pull.",
            "title": "Priority Fix",
            "type": "string"
          },
          "suggested_axes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "≤4 axis names from the same list.",
            "title": "Suggested Axes"
          }
        },
        "required": [
          "failure_highlights",
          "priority_fix",
          "suggested_axes"
        ],
        "title": "L1CritiqueOutput",
        "type": "object"
      }
    }
  },
  "l2_context/1": {
    "fields": [
      "axis_targeted",
      "l1_layout",
      "l1_overrides",
      "rationale",
      "fork_proposal"
    ],
    "json_schema": {
      "name": "l2_context",
      "strict": true,
      "schema": {
        "$defs": {
          "ForkProposal": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "1-2 sentences: why this line is exhausted, and what the fork changes.",
                "title": "Reason"
              },
              "unlock_schema_field_rename": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Let the fork's L1 rename a field on the inner l1_generate's output schema (it can only describe fields today). Set ONLY when the panels show the search stalling on what a field is FOR rather than on what it says — a field whose name misdescribes its content. Default false.",
                "title": "Unlock Schema Field Rename"
              }
            },
            "title": "ForkProposal",
            "type": "object",
            "required": [
              "reason",
              "unlock_schema_field_rename"
            ]
          },
          "L1Overrides": {
            "additionalProperties": false,
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "L1's sampling temperature.",
                "title": "Temperature"
              },
              "n_variants": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "How many variants L1 writes.",
                "title": "N Variants"
              }
            },
            "title": "L1Overrides",
            "type": "object",
            "required": [
              "temperature",
              "n_variants"
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "axis_targeted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the failure cluster's fix lands in the TARGET prompt, as `<node>.<field>` for a semantic failure or a param for a quantitative one — even where it shares a name with an l1_layout slot. Name it on every fire; it is the anchor the lever is judged against, not a label for the lever.",
            "title": "Axis Targeted"
          },
          "l1_layout": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "problem_description": {
                    "anyOf": [
                      {
                        "items": {
                          "enum": [
                            "answer_distribution",
                            "axis_memory",
                            "block_pool",
                            "budget_state",
                            "confounds",
                            "critique",
                            "demo_pool",
                            "detectable_move",
                            "diagnostics",
                            "escalation_panel",
                            "failing_samples",
                            "inner_narratives",
                            "l1_wounds",
                            "measurand",
                            "mutation_memory",
                            "pipeline_param_catalogue",
                            "plan",
                            "recombination_pool",
                            "rendered_prompt",
                            "sample_transcripts",
                            "task_context"
                          ],
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object",
                "required": [
                  "problem_description"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where in the reader node's own prompt each evidence panel is rendered. A slot is a position in that prompt, never the target-prompt field the evidence is about: the reader gets every placed panel whichever slot holds it. Keyed by SLOT — the properties are the only slots there are — each listing the panels to place there: a listed panel MOVES to that slot, an omitted one stays where it is, and a panel is only ever in one place.",
            "title": "L1 Layout"
          },
          "l1_overrides": {
            "anyOf": [
              {
                "$ref": "#/$defs/L1Overrides"
              },
              {
                "type": "null"
              }
            ]
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why this fire, in 1-2 sentences: the failure cluster you are attacking and the named data point behind it — a sample id, a count, a yield number. Required on every fire, including one that pulls no lever; a lever with no diagnosis behind it cannot be told from a guess.",
            "title": "Rationale"
          },
          "fork_proposal": {
            "anyOf": [
              {
                "$ref": "#/$defs/ForkProposal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "L2ContextOutput",
        "type": "object",
        "required": [
          "axis_targeted",
          "l1_layout",
          "l1_overrides",
          "rationale",
          "fork_proposal"
        ]
      }
    }
  },
  "l3_plan/1": {
    "fields": [
      "plan",
      "note",
      "rationale",
      "fork_proposal"
    ],
    "json_schema": {
      "name": "l3_plan",
      "strict": true,
      "schema": {
        "$defs": {
          "ForkProposal": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "1-2 sentences: why this line is exhausted, and what the fork changes.",
                "title": "Reason"
              },
              "unlock_schema_field_rename": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Let the fork's L1 rename a field on the inner l1_generate's output schema (it can only describe fields today). Set ONLY when the panels show the search stalling on what a field is FOR rather than on what it says — a field whose name misdescribes its content. Default false.",
                "title": "Unlock Schema Field Rename"
              }
            },
            "title": "ForkProposal",
            "type": "object",
            "required": [
              "reason",
              "unlock_schema_field_rename"
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "plan": {
            "description": "The strategy every later prompt reads until the next replan. Say what L2 and L1 should DO with the levers they hold — L2 moves which panels L1 sees and how wide it explores; L1 rewrites the target prompt's fields. A plan written in the solver's vocabulary instructs neither, and rides every downstream call regardless.",
            "title": "Plan",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "fork_proposal": {
            "anyOf": [
              {
                "$ref": "#/$defs/ForkProposal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "plan",
          "note",
          "rationale",
          "fork_proposal"
        ],
        "title": "L3PlanOutput",
        "type": "object"
      }
    }
  }
}
