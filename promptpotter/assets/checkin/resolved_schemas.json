{
  "checkin/1": {
    "fields": [
      "persona",
      "task_intent",
      "answer_format",
      "problem_description",
      "instruction",
      "thinking_style",
      "task_context",
      "assessment",
      "findings",
      "next_action",
      "recap"
    ],
    "json_schema": {
      "name": "checkin",
      "strict": true,
      "schema": {
        "$defs": {
          "CheckinTaskContext": {
            "additionalProperties": false,
            "properties": {
              "domain": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One noun phrase — the task family, e.g. 'competition mathematics'.",
                "title": "Domain"
              },
              "pipeline_purpose": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One sentence: what this campaign produces, for an outside reader.",
                "title": "Pipeline Purpose"
              },
              "data_characteristics": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One sentence (<=40 words): the sample properties L1 must account for — length, modality, distribution skew, known bias.",
                "title": "Data Characteristics"
              },
              "optimization_goals": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One sentence (<=40 words): what we optimise for, in operator vocabulary.",
                "title": "Optimization Goals"
              },
              "key_challenges": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One sentence (<=40 words): the 1-2 dominant failure patterns to defend against THIS round — a single current challenge, never a growing list.",
                "title": "Key Challenges"
              },
              "upstream_context": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Short framing prepended around problem_description, or empty.",
                "title": "Upstream Context"
              },
              "downstream_context": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Short framing appended around problem_description, or empty.",
                "title": "Downstream Context"
              }
            },
            "title": "CheckinTaskContext",
            "type": "object",
            "required": [
              "domain",
              "pipeline_purpose",
              "data_characteristics",
              "optimization_goals",
              "key_challenges",
              "upstream_context",
              "downstream_context"
            ]
          },
          "OriginFinding": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Checklist field id, e.g. 'task_description', 'column.query'.",
                "title": "Field"
              },
              "proposed_value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The value proposed for this field.",
                "title": "Proposed Value"
              },
              "confidence": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "'high' or 'low'. Only 'high' auto-confirms.",
                "title": "Confidence"
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "What in the input supports this — a header name, a sample value, or a stated operator preference. Findings with no evidence are rejected.",
                "title": "Evidence"
              }
            },
            "title": "OriginFinding",
            "type": "object",
            "required": [
              "field",
              "proposed_value",
              "confidence",
              "evidence"
            ]
          },
          "OriginNextAction": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "'ask' (need operator input), 'propose' (findings applied), or 'ready' (resolver believes origin complete — re-checked).",
                "title": "Kind"
              },
              "questions": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/OriginQuestion"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "For kind='ask': operator-facing questions, each naming the field it resolves so the answer applies directly.",
                "title": "Questions"
              }
            },
            "title": "OriginNextAction",
            "type": "object",
            "required": [
              "kind",
              "questions"
            ]
          },
          "OriginQuestion": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Checklist field id the answer resolves, e.g. 'column.query'.",
                "title": "Field"
              },
              "prompt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Short operator-facing question.",
                "title": "Prompt"
              },
              "options": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional closed set of acceptable answers; empty = free text.",
                "title": "Options"
              }
            },
            "title": "OriginQuestion",
            "type": "object",
            "required": [
              "field",
              "prompt",
              "options"
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Persona"
          },
          "task_intent": {
            "title": "Task Intent",
            "type": "string"
          },
          "answer_format": {
            "description": "The output contract only: the exact shape the scorer extracts, as described to you in context. The valid labels are appended deterministically — never list them here.",
            "title": "Answer Format",
            "type": "string"
          },
          "problem_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem Description"
          },
          "instruction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instruction"
          },
          "thinking_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "How to reason. Never the output shape or the scoring rule — those are answer_format's.",
            "title": "Thinking Style"
          },
          "task_context": {
            "anyOf": [
              {
                "$ref": "#/$defs/CheckinTaskContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "assessment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "One-line read of the current origin state.",
            "title": "Assessment"
          },
          "findings": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/OriginFinding"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Findings"
          },
          "next_action": {
            "anyOf": [
              {
                "$ref": "#/$defs/OriginNextAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "recap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "On a 'ready' turn: a jargon-free paragraph restating what the campaign will do, for the operator to confirm intent.",
            "title": "Recap"
          }
        },
        "required": [
          "persona",
          "task_intent",
          "answer_format",
          "problem_description",
          "instruction",
          "thinking_style",
          "task_context",
          "assessment",
          "findings",
          "next_action",
          "recap"
        ],
        "title": "CheckinOutput",
        "type": "object"
      }
    }
  }
}
