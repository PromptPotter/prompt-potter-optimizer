# deploy.config — adopter values for the Linux deploy scripts.
#
# Copy this file to `deploy.config` (gitignored) and fill in your own values:
#   cp deploy.config.example deploy.config
#
# All four scripts (bootstrap / install-service / install-tunnel /
# install-admin-bot) source `deploy.config` if present, then fall back to
# these defaults. Anything you leave commented uses the default shown.
# Every value can also be overridden inline, e.g.
#   PUBLIC_HOSTNAME=staging.example.com ./install-tunnel.sh

# --- identity -----------------------------------------------------------
# Short slug for your app. Drives the systemd unit name, the cloudflared
# tunnel name, the install-dir default, and the unit Description.
APP_NAME="myapp"

# uvicorn target — the FastAPI ASGI app, "package.module:attr".
APP_MODULE="myapp.main:app"

# Where systemd reads the environment from. Leave unset and it is $INSTALL_DIR/.env — correct on a
# box without SELinux. WITH SELinux, systemd (as root) is denied a file under $HOME, and the unit
# dies as "unavailable resources"; put the file under /etc and name it here instead.
#ENV_FILE="/etc/myapp.env"

# Optional admin bot module (only needed for install-admin-bot.sh).
ADMIN_BOT_MODULE="myapp.presentation.admin_bot"

# --- source + install ---------------------------------------------------
# git clone source — REQUIRED, edit before running bootstrap.sh.
REPO_URL="https://github.com/CHANGE-ME/your-repo.git"

# Where the repo is cloned / where the service runs from.
INSTALL_DIR="$HOME/$APP_NAME/your-repo"

# systemd User= (the account the service runs as).
RUN_USER="$USER"

# --- runtime ------------------------------------------------------------
BIND_HOST="127.0.0.1"          # uvicorn host (keep loopback behind the tunnel)
BIND_PORT="8001"               # uvicorn port
WEBAPP_DIR="webapp"            # static frontend dir built by `npm run build`
HEALTH_PATH="/api/v1/health"   # liveness endpoint the scripts curl
MEMORY_MAX=""                  # optional cgroup MemoryMax (e.g. "2G"); empty = no limit

# --- backend service (optional) -----------------------------------------
# The API the optimizer drives via /matches, cloned as a git sibling. Set these
# and update.sh keeps it in lockstep with the app. Leave BACKEND_DIR empty to skip.
BACKEND_DIR=""                 # e.g. $HOME/potter/TermNorm-excel/backend-api
BACKEND_SERVICE=""             # e.g. termnorm  (its systemd unit name)
BACKEND_PORT="8000"            # backend uvicorn port (health probed at /status)

# --- public edge (Cloudflare tunnel) -----------------------------------
# The hostname the app is served at. Cloudflare must be authoritative DNS for
# it — for a subdomain, the whole parent zone must live at Cloudflare (Free-plan rule).
PUBLIC_HOSTNAME="app.example.com"

# cloudflared tunnel name (defaults to APP_NAME if left unset).
TUNNEL_NAME="$APP_NAME"

# Browser origins allowed by the API (CORS). Usually https://$PUBLIC_HOSTNAME.
ALLOWED_ORIGINS="https://app.example.com"

# OAuth callback path appended to PUBLIC_HOSTNAME for the OIDC redirect URI.
OIDC_CALLBACK_PATH="/api/v1/auth/callback/google"

# --- brand (whitelabel) — DRAFT ------------------------------------------
# Wired and gate-green, but no fork has been built from it yet. If you are the
# first, read docs/developer/whitelabel.md's draft banner: it says exactly which
# half is proven and which is only intended.
#
# The ONE declaration of the name this unit wears. `brand-env.sh` fans it out
# both ways: the engine's copy into `.env`, the `NEXT_PUBLIC_*` twins exported
# for the webapp build. Leave a line commented to keep the upstream default —
# an unset value is never written, so nothing here half-brands the install.
#
# Read docs/developer/whitelabel.md before renaming anything NOT in this block:
# the package, the CLI verb and the .promptpotter/ state tree are a different
# tier, and renaming the state tree orphans every campaign under it.

# Spoken name — CLI greeting, argparse description, login wordmark.
#BRAND_SHORT_NAME="PromptPotter"
# Full product name — web app manifest, schema.org JSON-LD.
#BRAND_NAME="PromptPotter Live Unit"
# Service title — FastAPI /docs title and the `service` field of /health.
#BRAND_SERVICE_NAME="PromptPotter Optimizer"
#BRAND_DESCRIPTION="LLM-driven program evolution for prompts and pipeline parameters."

# Who DISTRIBUTES this unit — yours to repaint. (Who POWERS it is a provenance
# fact with no override; see whitelabel.md.)
#PUBLISHER_NAME="PromptPotter"
#PUBLISHER_URL="https://promptpotter.com"

# Your marketing site. EMPTY STRING drops the login showcase entirely, so a
# reseller never funnels its paying users upstream.
#MARKETING_URL="https://promptpotter.com"
#MARKETING_TITLE="PromptPotter"
#MARKETING_TAGLINE="..."

# Where your users go for help, docs and the legal pages. TERMS/PRIVACY/IMPRINT
# are separate on purpose: a distributor answers for its own terms, and clearing
# MARKETING_URL must not take the consent links down with it.
#SUPPORT_URL="https://github.com/PromptPotter/prompt-potter-optimizer/issues"
#DOCS_URL="https://github.com/PromptPotter/prompt-potter-optimizer"
#TERMS_URL="https://promptpotter.com/terms"
#PRIVACY_URL="https://promptpotter.com/privacy"
#IMPRINT_URL="https://promptpotter.com/imprint"
#LICENSE_URL="https://github.com/PromptPotter/prompt-potter-optimizer/blob/main/LICENSE"

# The unit's own public address. Defaults to https://$PUBLIC_HOSTNAME.
#BRAND_URL=""
