{
  "name": "PromptPotter Optimizer",
  "version": "v1.0",
  "nodes": {
    "l1_generate": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.7,
        "max_tokens": 8192,
        "output_format": "json",
        "prompt_family": "meta_scan_aware",
        "context_sources": ["scan_context", "critique", "task_context", "escalation_journal"],
        "response_parser": "candidate_list"
      }
    },
    "l1_evaluate": {
      "type": "evaluation",
      "config": {
        "improvement_threshold": 0.01
      }
    },
    "critique": {
      "type": "agent",
      "config": {
        "temperature": 0.3,
        "max_tokens": 4096,
        "agent_class": "CritiqueAgent",
        "positive_threshold": 0.7
      }
    },
    "l2_refine_context": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.3,
        "max_tokens": 2048,
        "output_format": "json",
        "prompt_family": "l2_refine_context",
        "context_sources": ["critique", "task_context", "l2_directive"],
        "response_parser": "transition_result"
      }
    },
    "l3_modify_plan": {
      "type": "llm/meta",
      "config": {
        "temperature": 0.5,
        "max_tokens": 2048,
        "output_format": "json",
        "prompt_family": "l3_modify_plan",
        "context_sources": ["critique", "task_context", "plan", "escalation_journal"],
        "response_parser": "transition_result"
      }
    }
  },
  "pipelines": {
    "l1_round": ["l1_generate", "l1_evaluate"],
    "l1_round_with_critique": ["l1_generate", "l1_evaluate", "critique"],
    "l2_escalation": ["l2_refine_context", "l1_generate", "l1_evaluate", "critique"],
    "l3_escalation": ["l3_modify_plan", "l2_refine_context", "l1_generate", "l1_evaluate", "critique"]
  }
}
