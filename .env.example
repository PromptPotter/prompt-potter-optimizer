# Environment Configuration
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001

# CORS allowlist (comma-separated). LEAVE EMPTY unless a cross-origin client
# needs the API: the webapp is served same-origin so it needs no entry. Never
# use `*` — the API serves credentialed requests, so a wildcard would let any
# site make authenticated calls. Set the exact origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.promptpotter.dev
ALLOWED_ORIGINS=

# LLM model fallback (when CampaignConfig.optimizer_llm.model is null).
# Provider is selected per-campaign on optimizer_llm.provider — no env default.
LLM_MODEL=openai/gpt-oss-120b

# LLM Provider API Keys (set whichever providers you'll use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Langfuse Observability (get keys from https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# File-based observability (traces, experiments, events.jsonl)
OBS_ENABLED=true
