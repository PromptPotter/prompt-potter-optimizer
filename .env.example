# Every key here is declared on `Settings` (promptpotter/config/settings.py), or is read
# from the environment explicitly and marked as such. Settings is `extra: "ignore"`, so a
# key it does not declare is swallowed in silence — this file used to carry six of those
# (API_HOST, API_PORT, LLM_PROVIDER, LLM_MODEL, MAX_DATASET_SIZE, MAX_ITERATIONS), each
# reading like a supported knob and configuring nothing.

# Environment Configuration
ENVIRONMENT=development

# CORS allowlist (comma-separated). LEAVE EMPTY unless a cross-origin client
# needs the API: the webapp is served same-origin so it needs no entry. Never
# use `*` — the API serves credentialed requests, so a wildcard would let any
# site make authenticated calls. Set the exact origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.promptpotter.dev
ALLOWED_ORIGINS=

# Optimizer LLM: provider + model are both campaign-scoped (optimizer_llm in
# campaign.json), resolved concrete at the resolve_optimizer_spec seam. There is
# no env model default — a model named here would configure nothing.

# LLM Provider API Keys (set whichever providers you'll use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Bearer token for the TermNorm backend. Bound to the `termnorm` connector alone
# (Connector.auth_token) — no other backend ever receives it.
TERMNORM_TOKEN=

# Langfuse Observability (get keys from https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# File-based observability (traces, events.jsonl)
OBS_ENABLED=true

# Deployment posture. HARDENED_MODE gates the production fences;
# MACHINE_RUN_CAPACITY is how many campaigns this box runs at once (the
# machine-busy gate). RATE_LIMITS is a JSON object; empty means unlimited.
HARDENED_MODE=false
MACHINE_RUN_CAPACITY=1

# Read from the environment DIRECTLY, not via Settings: `off` bypasses OIDC and
# resolves to the CLI's on-disk identity. Local harness only, never in production.
# PROMPTPOTTER_AUTH=off
