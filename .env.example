# Every key here is declared on `Settings` (promptpotter/config/settings.py), or is read
# from the environment explicitly and marked as such. Settings is `extra: "ignore"`, so a
# key it does not declare is swallowed in silence — this file used to carry six of those
# (API_HOST, API_PORT, LLM_PROVIDER, LLM_MODEL, MAX_DATASET_SIZE, MAX_ITERATIONS), each
# reading like a supported knob and configuring nothing.

# CORS allowlist (comma-separated). LEAVE EMPTY unless a cross-origin client
# needs the API: the webapp is served same-origin so it needs no entry. A `*`,
# a path or a pattern refuses to load — the API serves credentialed requests,
# so a wildcard would let any site make authenticated calls. Set the exact
# origin(s), e.g.:
#   ALLOWED_ORIGINS=https://app.promptpotter.com
ALLOWED_ORIGINS=

# Display identity for the terminal + API surfaces. DON'T hand-edit on a
# deployed box: `deploy-linux/deploy.config`'s brand block is the declaration and
# `brand-env.sh` writes these three from it on every bootstrap/update, so a hand
# edit is reverted at the next deploy. Renaming beyond these three (the package,
# the CLI verb, the .promptpotter/ tree) → deploy-linux/README.md.
#BRAND_SHORT_NAME=PromptPotter
#BRAND_SERVICE_NAME=PromptPotter Optimizer
#BRAND_DOCS_URL=https://github.com/PromptPotter/prompt-potter-optimizer

# Optimizer LLM: provider + model are per node in the optimizer's manifest
# (promptpotter/assets/optimizers/<name>/pipeline.yaml), adjusted per campaign by
# optimization.nodes. There is no env model default — a model named here would
# configure nothing.

# LLM Provider API Keys (set whichever providers you'll use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# The TermNorm backend: where it listens and the bearer it takes. Both bound to the `termnorm`
# connector alone (Connector.endpoint / auth_token), and no request can name another host for it.
TERMNORM_URL=http://127.0.0.1:8000
TERMNORM_TOKEN=

# Langfuse Observability (get keys from https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# File-based observability (traces, events.jsonl)
OBS_ENABLED=true

# Your MLflow server. Unset: off. Set, each round lands there as a run and each finished
# cycle's winner as a prompt version (docs/operations/observability.md § MLflow).
MLFLOW_TRACKING_URI=

# Deployment posture. HARDENED_MODE gates the production fences;
# MACHINE_RUN_CAPACITY is how many campaigns this box runs at once (the
# machine-busy gate). RATE_LIMITS is a JSON object; empty means unlimited.
HARDENED_MODE=false
MACHINE_RUN_CAPACITY=1

# Which install datasets an account sees, comma-separated; the host (the terminal, the claimed
# browser account) sees every one. Unset: every account does (a developer's install). An offered dataset that cannot start here stays listed, greyed, with why;
# `deploy-linux/update.sh` installs the extras the offer needs (`python -m promptpotter offer-extras`)
# A name that is no dataset stops both the deploy and the server's boot.
DATASET_OFFER=

# Who may claim this box from the browser. Signing up now entitles, so entitlement
# cannot stand in front of the host-admin claim any more — this names the one
# sign-in allowed to write it. Unset means nobody claims the box, which also leaves
# the terminal on the `default` tenant while browsers resolve their own.
HOST_ADMIN_EMAIL=

# The LIFETIME (not per-day) USD ceiling a free-tier account spends against — the
# only thing bounding a stranger who signs up. The operator of the box is exempt.
# Raise it for one person by hand on `projects/{tenant}/user.json`.
FREE_TIER_SPEND_CAP_USD=0.30
# The operator-admin channel (docs/decisions.md § 0004) — outbound-only, no inbound door. The first two arm both
# the /block bot and the one-shot notices the API fires when an account first exists; leave them
# unset and those notices are logged instead of sent. Give the bot its OWN BotFather token: two
# units polling getUpdates on one token fight over the offset, and Telegram answers 409 to either
# if a webhook is registered on it. Setup: deploy-linux/README.md § Admin bot.
ADMIN_BOT_TELEGRAM_TOKEN=
ADMIN_BOT_CHAT_ID=
# Optional second factor on the mutating verbs (/block, /grant, …).
ADMIN_BOT_PASSPHRASE=

# Where a new account is announced for the CRM. Unset = nothing is sent, and the sign-in that
# created the account still succeeds — the forward is best-effort by contract.
N8N_SIGNUP_WEBHOOK_URL=

# Where the admin bot sends what every account did in the last day, every half hour, for a
# morning briefing to print. The secret travels as the `X-Trail-Secret` header. Unset = nothing
# is sent. Both belong in the BOT's env file where that is split out.
N8N_TRAIL_WEBHOOK_URL=
N8N_TRAIL_WEBHOOK_SECRET=

# Opens `/api/v1/site-records/{table}` to whoever sends it as `Authorization: Bearer …`, so your
# own website's automation can keep its visit log, messages and newsletter list on this box.
# Unset = those routes answer 404. Make it long and random; deploy-linux/README.md § Optional outbound feeds.
SITE_RECORDS_TOKEN=

# `own` (default) shows an account only its own machine slots, everyone else's as a count: a box
# strangers sign up to. `all` names every slot to every account, for a team that trusts itself.
# MACHINE_STATUS_SCOPE=all

# Unset (default): each account replays only its own measurements. A name: every account files into
# and replays from one install-owned archive at `.archives/<name>/`, so no cell is paid for twice —
# and each account sees what the others ran. Only the host compacts or purges it. For a team that
# trusts itself.
# SHARED_ARCHIVE=team

# `off` bypasses OIDC and resolves every request to the CLI's on-disk identity: a local
# harness only, never a served box. Default `on`: no sign-in provider configured means 401.
# PROMPTPOTTER_AUTH=off
