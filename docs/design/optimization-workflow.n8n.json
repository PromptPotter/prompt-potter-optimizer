    {
      "parameters": {
        "jsCode": "let previousData;\n\ntry {\n  // Try to get the previous output from this node\n  previousData = $('count_plus_one').last().json;\n} catch (error) {\n  // If it doesn't exist yet (first run), use full_input\n  previousData = $('full_input').item.json;\n}\n\nreturn [{ \n  json: { \n    ...previousData, \n    counter: (previousData.counter || 0) + 1 \n  } \n}];"
      },
