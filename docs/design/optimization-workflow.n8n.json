      "id": "088c98e3-13ae-4f44-859c-e0359bc7bfa7",
      "name": "Download file"
    },
    {
      "parameters": {
        "jsCode": "const binaryData = $input.item.binary.data;\nconst text = Buffer.from(binaryData.data, 'base64').toString('utf-8');\n\n// Split by finding complete JSON objects\nconst objects = [];\nlet braceCount = 0;\nlet currentObject = '';\nlet inString = false;\nlet escapeNext = false;\n\nfor (let i = 0; i < text.length; i++) {\n  const char = text[i];\n  \n  if (escapeNext) {\n    currentObject += char;\n    escapeNext = false;\n    continue;\n  }\n  \n  if (char === '\\\\') {\n    escapeNext = true;\n    currentObject += char;\n    continue;\n  }\n  \n  if (char === '\"') {\n    inString = !inString;\n  }\n  \n  currentObject += char;\n  \n  if (!inString) {\n    if (char === '{') braceCount++;\n    if (char === '}') braceCount--;\n    \n    if (braceCount === 0 && currentObject.trim()) {\n      objects.push(JSON.parse(currentObject.trim()));\n      currentObject = '';\n    }\n  }\n}\n\nreturn objects.map(obj => ({ json: obj }));"
      },
