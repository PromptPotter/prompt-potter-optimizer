# Python — patterns whose plain names also occur in JS/TS subprojects
# (`lib/`, `lib64/`, `build/`, `dist/`, `var/`) are anchored with `/` so
# they only match at repo root. `webapp/lib/` was silently ignored by an
# unanchored `lib/` until 2026-05-07 — don't reintroduce that trap.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
/var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Logs
*.log
logs/
*.out

# Docker
.dockerignore

# Jupyter Notebook
.ipynb_checkpoints

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Database
*.db
*.sqlite3

# OS
Thumbs.db

data/
!promptpotter/shared/data/

# Linting cache
.ruff_cache/

# Claude's goldmine capture — rolling mirror of the last campaign's live stdout
# (most-recent-only) + active-work scratch. latest.log is already caught by *.log.
.goldmine/

# Local dev tools
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/potter-run/
!.claude/skills/potter-debt-sweep/
!.claude/hooks/
.claude/hooks/doc_drift_ratio.py
tools
.playwright-cli/

# PromptPotter runtime data (generated by API)
.promptpotter/

# Deploy adopter config — operator-specific values, like .env / .promptpotter/
deploy-linux/deploy.config
deploy-linux/*.local.md

# Per-dataset HF/Excel cache — regenerable, dataset-name keyed
datasets/*/cache.json
# demo samples are hand-authored, not regenerable — commit them
!datasets/email-tagging/cache.json

# Research benchmark cuts. The loader in DATASET_LOADERS is what ships, and the drawn cut
# stays out — but the CONFIG travels: it declares the instrument a measurement came from,
# and an untracked knob silently reverts on the next clone or deploy.
#
# `datasets/justlogic-d23/` read `datasets/justlogic-d23/` until 2026-07-30 — the whole
# directory, config included, against the sentence directly above and against how its own
# sibling is written one line down. It cost exactly what that sentence predicts: the cut
# existed on one disk and on no clone, `list_datasets()` named a dataset no fresh checkout
# could resolve, and the L4 panel is keyed on its cells (`justlogic-d23/seed-0`).
datasets/justlogic-d23/cache.json
datasets/justlogic-d234/cache.json

# Recon-script raw data downloads (NaturalPlan GitHub JSON, etc.) — regenerable
.cache/

# Local campaign config (user-specific overrides)
campaign_config.json

# teach-impeccable skill scratch (unrelated to PromptPotter)
.impeccable.md

# Release staging — scripts/build_release.py copies webapp/out and the tracked
# datasets/ definitions in here so setuptools can ship them. Both are derived, so
# they are built on demand, never committed.
promptpotter/assets/webapp/
promptpotter/assets/benchmarks/
