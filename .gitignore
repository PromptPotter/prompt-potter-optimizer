# Python — patterns whose plain names also occur in JS/TS subprojects
# (`lib/`, `lib64/`, `build/`, `dist/`, `var/`) are anchored with `/` so
# they only match at repo root. `webapp/lib/` was silently ignored by an
# unanchored `lib/` until 2026-05-07 — don't reintroduce that trap.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
/var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Logs
*.log
logs/
*.out

# Docker
.dockerignore

# Jupyter Notebook
.ipynb_checkpoints

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Database
*.db
*.sqlite3

