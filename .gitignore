# Python — patterns whose plain names also occur in JS/TS subprojects
# (`lib/`, `lib64/`, `build/`, `dist/`, `var/`) are anchored with `/` so
# they only match at repo root. `webapp/lib/` was silently ignored by an
# unanchored `lib/` until 2026-05-07 — don't reintroduce that trap.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
/var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Logs
*.log
logs/
*.out
!paper/evidence/**/*.log

# Docker
.dockerignore

# Jupyter Notebook
.ipynb_checkpoints

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Database
*.db
*.sqlite3

# OS
Thumbs.db

data/
!promptpotter/infrastructure/llm/data/

# Linting cache
.ruff_cache/
.gate_cache/

# `latest-readout-path.txt`: where the newest terminal launch's `readout.log` is.
# Sole writer: the CLI launch. Nothing else belongs in here.
logs/

# Ad-hoc human/agent dumps — launch logs, scratch notes. Never engine-written.
.scratch/

# Local dev tools
.claude/*
!.claude/settings.json
!.claude/digest.py
!.claude/skills/
.claude/skills/*
!.claude/skills/potter-run/
!.claude/skills/potter-self/
!.claude/skills/potter-box/
!.claude/skills/potter-release/
!.claude/skills/digest/
!.claude/hooks/
tools
.playwright-cli/

# PromptPotter runtime data (generated by API)
.promptpotter/

# Deploy adopter config — operator-specific values, like .env / .promptpotter/
deploy-linux/deploy.config
deploy-linux/*.local.md

# Nothing under promptpotter/assets/datasets/ is ignored: it holds only the shipped templates. An operator's own
# definitions, a fetched bank, a built panel and its task directories land in the tenant tier under
# .promptpotter/ (`infrastructure/store/CLAUDE.md` § Dataset content has two tiers). A stray file
# there is a bug to see, never one to hide.

# Recon-script raw data downloads (NaturalPlan GitHub JSON, etc.) — regenerable
.cache/

# Local campaign config (user-specific overrides)
campaign_config.json

# Third-party agent harness config — points its own tool at this repo's CLAUDE.md.
# Local to whoever runs that tool; it configures no PromptPotter behaviour.
opencode.json

# Release staging — scripts/build_release.py copies webapp/out in here so setuptools
# can ship it. Derived, so it is built on demand, never committed.
promptpotter/assets/webapp/

# Playwright's per-run output — traces and screenshots of the browser walk
# (`webapp/e2e/`). Every byte is regenerated by the next run, and a retained
# trace is a zip of the operator's own campaign data.
webapp/test-results/
webapp/.last-run.json

# per-machine autonomy mode (root CLAUDE.md § Working principles)
CLAUDE.local.md
