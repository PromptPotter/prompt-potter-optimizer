!.claude/skills/potter-l1-meta-campaign/
tools

# PromptPotter runtime data (generated by API)
.promptpotter/

# Per-dataset HF/Excel cache — regenerable, dataset-name keyed
datasets/*/cache.json

# Recon-script raw data downloads (NaturalPlan GitHub JSON, etc.) — regenerable
.cache/

