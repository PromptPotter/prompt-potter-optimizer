# Python — patterns whose plain names also occur in JS/TS subprojects
# (`lib/`, `lib64/`, `build/`, `dist/`, `var/`) are anchored with `/` so
# they only match at repo root. `webapp-react/lib/` was silently ignored
# by an unanchored `lib/` until 2026-05-07 — don't reintroduce that trap.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
/var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
settings.local.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Logs
*.log
logs/
*.out

# Docker
.dockerignore

# Jupyter Notebook
.ipynb_checkpoints

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Database
*.db
*.sqlite3

# OS
Thumbs.db

data/

# Linting cache
.ruff_cache/

# Local dev tools
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/potter-run/
!.claude/skills/potter-review/
tools

# PromptPotter runtime data (generated by API)
.promptpotter/

# Per-dataset HF/Excel cache — regenerable, dataset-name keyed
datasets/*/cache.json

# Local campaign config (user-specific overrides)
campaign_config.json

# teach-impeccable skill scratch (unrelated to PromptPotter)
.impeccable.md

# Deployed Next.js static export (`webapp-react/out/` copied to `webapp/`
# by `npm run deploy`). Pure build artefact — source lives in
# `webapp-react/`, the FastAPI mount at `promptpotter/main.py` guards for
# absence, and pip never packages it. Run `npm run deploy` from
# `webapp-react/` after a fresh checkout to populate it.
/webapp/
