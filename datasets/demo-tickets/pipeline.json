{
  "name": "Demo — Support Tickets",
  "version": "v0.1",
  "description": "Try-and-learn demo: classify a customer-support ticket into one of five categories. Single llm_only generation node against TermNorm /matches, exact-match scoring.",
  "backend_name": "TermNorm",
  "backend_type": "termnorm",
  "available_models": ["openai/gpt-oss-120b"],
  "nodes": {
    "llm_only": {
      "type": "generation",
      "runtime": "backend",
      "node_role": "ranker",
      "description": "Direct LLM generation: read the ticket, emit one category label. reasoning_effort floored at low — the task is short and the optimizer can raise it if it pays.",
      "config": {
        "provider": "groq",
        "model": "openai/gpt-oss-120b",
        "temperature": 0.0,
        "reasoning_effort": "low"
      },
      "prompt_meta": {
        "family": "llm_only",
        "template_variables": ["query"],
        "description": "System prompt for support-ticket classification"
      },
      "optimizer": {
        "param_keys": ["temperature", "max_tokens", "reasoning_effort", "persona", "task_intent", "problem_description", "instruction", "thinking_style", "answer_format"],
        "param_allowed_values": {
          "reasoning_effort": ["none", "default", "low"]
        },
        "observation_name": "llm_only",
        "observation_mappings": [
          {
            "pipeline_key": "final_ranking",
            "output_field": "generated_text",
            "is_llm": true
          }
        ],
        "langfuse_type": "generation"
      }
    }
  },
  "pipelines": {
    "default": ["llm_only"]
  },
  "llm_defaults": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b"
  }
}
