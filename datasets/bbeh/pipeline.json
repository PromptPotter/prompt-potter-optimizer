{
  "name": "BBEH",
  "version": "v0.1",
  "description": "Big-Bench Extra Hard — per-task prompt optimization against exact-match scoring",
  "backend_name": "BBEH Benchmark",
  "backend_type": "benchmark",
  "type": "llm-only",
  "available_models": ["openai/gpt-oss-120b"],
  "nodes": {
    "llm_only": {
      "type": "generation",
      "runtime": "frontend",
      "node_role": "ranker",
      "description": "Direct LLM call: prompt + question -> answer. No retrieval or enrichment nodes.",
      "config": {
        "model": "openai/gpt-oss-120b",
        "temperature": 0.0,
        "max_tokens": 2048
      },
      "prompt_meta": {
        "family": "llm_only",
        "template_variables": ["query"],
        "description": "System prompt for BBEH task evaluation"
      },
      "optimizer": {
        "param_keys": ["temperature", "max_tokens", "model", "prompt"],
        "langfuse_type": "generation"
      }
    }
  },
  "pipelines": {
    "default": ["llm_only"]
  },
  "llm_defaults": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b"
  }
}
