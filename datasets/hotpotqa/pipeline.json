{
  "name": "HotPotQA",
  "version": "v0.1",
  "description": "LLM-only multi-hop QA — prompt optimization over context passages",
  "backend_name": "HotPotQA Benchmark",
  "backend_type": "benchmark",
  "type": "llm-only",
  "nodes": {
    "llm_only": {
      "type": "generation",
      "runtime": "local",
      "node_role": "ranker",
      "description": "Direct LLM call: context passages + question -> reasoning chain -> short answer. No retrieval nodes.",
      "config": {
        "model": "openai/gpt-oss-120b",
        "temperature": 0.0,
        "max_tokens": 1000
      },
      "optimizer": {
        "param_keys": ["temperature", "max_tokens", "model", "prompt"],
        "langfuse_type": "generation"
      }
    }
  },
  "pipelines": {
    "default": ["llm_only"]
  },
  "llm_defaults": {
    "provider": "groq",
    "model": "openai/gpt-oss-120b"
  }
}
